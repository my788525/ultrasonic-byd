<?xml version="1.0" encoding="utf-8"?>
<!-- A 30 dp thumb: the default one is about half that, which is impossible to grab while the
     car is moving. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#FFFFFFFF" />
    <stroke
        android:width="3dp"
        android:color="#66000000" />
    <size
        android:width="30dp"
        android:height="30dp" />
</shape>
