<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:a="http://schemas.android.com/apk/res/android">

    <!--
        The menu that belongs to a song the user has on the device. It offers exactly
        what a downloaded song can do: play it or remove it. "Download" and "Pin" do
        not exist here, because the file already is the download, and "Pin" is an
        online-server concept that has no meaning for a file that lives on the car.
    -->
    <item
        a:id="@+id/download_song_menu_play"
        a:title="@string/common.play_now" />
    <item
        a:id="@+id/download_song_menu_delete"
        a:title="@string/common.delete" />

</menu>
