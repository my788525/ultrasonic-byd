    <string name="floating_text_shadow_title">Text shadow</string>
    <string name="floating_text_shadow_summary">A dark shadow behind the text improves contrast over a busy map. Turn it off when the shadow makes the text look fuzzy.</string>
    <string name="floating_idle_brightness_title">Idle brightness</string>
    <string name="floating_idle_brightness_summary">How dim the window gets after a few seconds without a touch. 100 keeps it fully bright; lower values fade it more so it stops drawing the eye. Lyric tiers are scaled up automatically so lyrics stay readable.</string>
