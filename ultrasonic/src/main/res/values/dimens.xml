<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Height of one music-library tile in the home grid. -->
    <dimen name="home_grid_tile_height">104dp</dimen>
    <!-- Height of one playlist tile in the home "My Playlists" grid. Taller than the library
         tile because it carries a 92dp cover plus up to two lines of the playlist name. -->
    <dimen name="home_playlist_tile_height">156dp</dimen>
    <!-- Fixed width of one playlist tile. The home playlist grid scrolls horizontally, so a
         match_parent width would make a single card fill the whole screen. -->
    <dimen name="home_playlist_tile_width">148dp</dimen>
    <!-- Gap between grid tiles (applied as a margin on each tile, so the visual gap is 2x). -->
    <dimen name="home_grid_tile_gap">6dp</dimen>
</resources>
