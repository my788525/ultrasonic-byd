<?xml version="1.0" encoding="utf-8"?>
<!--
  Palette colors of the car head unit UI.

  Every palette is a dark, desaturated gradient: a near black top that slowly turns into a
  tinted bottom, surfaces slightly above the background and one muted accent. Bright white is
  never used as a large area, it is reserved for text on top of dark surfaces only.

  The names match the keys in @array/themeValues and CarPalette.kt
-->
<resources>
    <!-- Text colors, shared by all palettes -->
    <color name="pal_text_primary">#E7EBF1</color>
    <color name="pal_text_secondary">#99A3B1</color>
    <color name="pal_on_accent">#0A0D12</color>
    <color name="pal_on_accent_container">#DCE4EE</color>

    <!-- 1 · Graphite night · neutral, the default -->
    <color name="pal_graphite_bg_top">#0A0D12</color>
    <color name="pal_graphite_bg_bottom">#171E28</color>
    <color name="pal_graphite_surface">#121821</color>
    <color name="pal_graphite_surface_alt">#1A2230</color>
    <color name="pal_graphite_accent">#6F9BC7</color>
    <color name="pal_graphite_accent_soft">#1D2A38</color>
    <color name="pal_graphite_outline">#2B3542</color>

    <!-- 2 · Deep ocean · cool blue -->
    <color name="pal_ocean_bg_top">#050A13</color>
    <color name="pal_ocean_bg_bottom">#10243C</color>
    <color name="pal_ocean_surface">#0C1725</color>
    <color name="pal_ocean_surface_alt">#12233A</color>
    <color name="pal_ocean_accent">#4F93DB</color>
    <color name="pal_ocean_accent_soft">#16273C</color>
    <color name="pal_ocean_outline">#23364D</color>

    <!-- 3 · Aurora teal · green cyan -->
    <color name="pal_aurora_bg_top">#040F0D</color>
    <color name="pal_aurora_bg_bottom">#0C2B26</color>
    <color name="pal_aurora_surface">#081916</color>
    <color name="pal_aurora_surface_alt">#0F2420</color>
    <color name="pal_aurora_accent">#3FC3A9</color>
    <color name="pal_aurora_accent_soft">#12312C</color>
    <color name="pal_aurora_outline">#1F3B36</color>

    <!-- 4 · Dusk violet · purple -->
    <color name="pal_violet_bg_top">#090611</color>
