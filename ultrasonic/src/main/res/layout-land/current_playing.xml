<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    a:id="@+id/player_root"
    a:layout_width="fill_parent"
    a:layout_height="fill_parent"
    a:baselineAligned="false"
    a:orientation="horizontal"
    a:padding="12dp">

    <ViewFlipper
        a:id="@+id/current_playing_playlist_flipper"
        a:layout_width="0dp"
        a:layout_height="fill_parent"
        a:layout_marginEnd="12dp"
        a:layout_weight="1.15"
        tools:ignore="UselessParent">

        <RelativeLayout
            a:id="@+id/current_playing_album_art_layout"
            a:layout_width="fill_parent"
            a:layout_height="fill_parent"
            a:gravity="start"
            a:orientation="vertical">

            <ImageView
                a:id="@+id/current_playing_album_art_image"
                a:layout_width="fill_parent"
                a:layout_height="fill_parent"
                a:contentDescription="@string/albumArt"
                a:scaleType="centerCrop" />

            <LinearLayout
                a:id="@+id/album_art_inside"
                a:layout_width="fill_parent"
                a:layout_height="fill_parent"
                a:gravity="bottom"
                a:orientation="vertical">

                <LinearLayout
                    a:id="@+id/song_rating"
                    a:layout_width="match_parent"
                    a:layout_height="52dip"
                    a:layout_gravity="center"
                    a:layout_margin="12dip"
                    a:orientation="horizontal"
                    tools:ignore="UselessParent">

                    <ImageView
                        a:id="@+id/song_five_star_1"
                        a:layout_width="0dip"
                        a:layout_height="fill_parent"
                        a:layout_weight="1"
                        a:background="@android:color/transparent"
                        a:focusable="false"
                        a:gravity="center_vertical"
                        a:importantForAccessibility="no"
                        a:padding="8dip"
                        a:scaleType="fitCenter"
                        a:src="@drawable/star_hollow_outline" />

                    <ImageView
                        a:id="@+id/song_five_star_2"
                        a:layout_width="0dip"
                        a:layout_height="fill_parent"
                        a:layout_weight="1"
                        a:background="@android:color/transparent"
                        a:focusable="false"
                        a:gravity="center_vertical"
                        a:importantForAccessibility="no"
                        a:padding="8dip"
                        a:scaleType="fitCenter"
                        a:src="@drawable/star_hollow_outline" />

                    <ImageView
                        a:id="@+id/song_five_star_3"
                        a:layout_width="0dip"
                        a:layout_height="fill_parent"
                        a:layout_weight="1"
                        a:background="@android:color/transparent"
                        a:focusable="false"
                        a:gravity="center_vertical"
                        a:importantForAccessibility="no"
                        a:padding="8dip"
                        a:scaleType="fitCenter"
                        a:src="@drawable/star_hollow_outline" />

                    <ImageView
                        a:id="@+id/song_five_star_4"
                        a:layout_width="0dip"
                        a:layout_height="fill_parent"
                        a:layout_weight="1"
                        a:background="@android:color/transparent"
                        a:focusable="false"
                        a:gravity="center_vertical"
                        a:importantForAccessibility="no"
                        a:padding="8dip"
                        a:scaleType="fitCenter"
                        a:src="@drawable/star_hollow_outline" />

                    <ImageView
                        a:id="@+id/song_five_star_5"
                        a:layout_width="0dip"
                        a:layout_height="fill_parent"
                        a:layout_weight="1"
                        a:background="@android:color/transparent"
                        a:focusable="false"
                        a:gravity="center_vertical"
                        a:importantForAccessibility="no"
                        a:padding="8dip"
                        a:scaleType="fitCenter"
                        a:src="@drawable/star_hollow_outline" />

                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <include
            a:id="@+id/playlist"
            layout="@layout/current_playlist" />

        <include
            a:id="@+id/lyrics_page"
            layout="@layout/lyrics" />
    </ViewFlipper>

    <LinearLayout
        a:layout_width="0dp"
        a:layout_height="match_parent"
        a:layout_weight="1"
        a:gravity="center_vertical"
        a:orientation="vertical">

        <LinearLayout
            a:id="@+id/player_mode_bar"
            a:layout_width="match_parent"
            a:layout_height="40dp"
            a:layout_marginStart="12dp"
            a:layout_marginEnd="12dp"
            a:layout_marginBottom="8dp"
            a:gravity="center"
            a:orientation="horizontal"
            a:padding="3dp">

            <TextView
                a:id="@+id/player_tab_cover"
                a:layout_width="0dp"
                a:layout_height="match_parent"
                a:layout_weight="1"
                a:gravity="center"
                a:text="@string/player_view_cover"
                a:textColor="@color/pal_text_primary"
                a:textSize="14sp"
                a:textStyle="bold" />

            <TextView
                a:id="@+id/player_tab_lyrics"
                a:layout_width="0dp"
                a:layout_height="match_parent"
                a:layout_weight="1"
                a:gravity="center"
                a:text="@string/player_view_lyrics"
                a:textColor="@color/pal_text_secondary"
                a:textSize="14sp"
                a:textStyle="bold" />

            <TextView
                a:id="@+id/player_tab_queue"
                a:layout_width="0dp"
                a:layout_height="match_parent"
                a:layout_weight="1"
                a:gravity="center"
                a:text="@string/player_view_queue"
                a:textColor="@color/pal_text_secondary"
                a:textSize="14sp"
                a:textStyle="bold" />
        </LinearLayout>

        <include layout="@layout/player_media_info" />

        <include layout="@layout/player_slider" />

        <include layout="@layout/media_buttons" />
    </LinearLayout>

</LinearLayout>
