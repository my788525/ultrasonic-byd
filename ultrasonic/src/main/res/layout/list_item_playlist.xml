<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    a:minHeight="72dp"
    a:background="?android:attr/selectableItemBackground"
    a:clickable="true"
    a:focusable="true"
    a:gravity="center_vertical"
    a:orientation="horizontal"
    a:paddingStart="16dp"
    a:paddingEnd="8dp">

    <androidx.appcompat.widget.AppCompatImageView
        a:id="@+id/playlist_icon"
        a:layout_width="24dp"
        a:layout_height="24dp"
        a:contentDescription="@null"
        a:src="@drawable/ic_menu_playlists"
        app:tint="?attr/colorPrimary" />

    <LinearLayout
        a:layout_width="0dp"
        a:layout_height="wrap_content"
        a:layout_marginStart="16dp"
        a:layout_weight="1"
        a:orientation="vertical"
        a:paddingTop="10dp"
        a:paddingBottom="10dp">

        <TextView
            a:id="@+id/playlist_name"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:ellipsize="end"
            a:maxLines="1"
            a:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            a:id="@+id/playlist_subtitle"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:ellipsize="end"
            a:maxLines="1"
            a:textAppearance="?android:attr/textAppearanceSmall"
            a:visibility="gone" />
    </LinearLayout>

    <ImageButton
        a:id="@+id/playlist_play"
        a:layout_width="48dp"
        a:layout_height="48dp"
        a:background="?attr/selectableItemBackgroundBorderless"
        a:contentDescription="@string/common.play_now"
        a:padding="12dp"
        a:src="@drawable/media_start"
        app:tint="?attr/colorPrimary" />

</LinearLayout>
