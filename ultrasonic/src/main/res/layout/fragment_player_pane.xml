<?xml version="1.0" encoding="utf-8"?>
<!--
  The right hand panel of the two pane layout.

  Combines a compact Now Playing header (cover, title, artist, status badge) at the top,
  a central stage for synced lyrics or the playback queue, and a high-contrast car control
  dock at the bottom.
-->
<FrameLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:id="@+id/player_pane_backdrop_root"
    a:layout_width="match_parent"
    a:layout_height="match_parent">

    <!-- Fullscreen only. The current album art fills the whole pane; the scrim View on top
         is rebuilt from the active CarPalette so the tint follows the chosen theme. Both
         stay GONE in the two pane layout, where the window gradient is the background. -->
    <ImageView
        a:id="@+id/pane_backdrop"
        a:layout_width="match_parent"
        a:layout_height="match_parent"
        a:contentDescription="@null"
        a:scaleType="centerCrop"
        a:src="@drawable/car_backdrop_placeholder"
        a:visibility="gone"
        tools:visibility="visible" />

    <View
        a:id="@+id/pane_backdrop_scrim"
        a:layout_width="match_parent"
        a:layout_height="match_parent"
        a:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        a:id="@+id/player_pane_root"
        a:layout_width="match_parent"
        a:layout_height="match_parent"
        a:orientation="vertical"
        a:paddingStart="16dp"
        a:paddingTop="8dp"
        a:paddingEnd="16dp"
        a:paddingBottom="10dp">

    <!-- Compact Now Playing header so the driver always sees what is playing even when
         browsing folders, albums, artists, or settings on the left pane. -->
    <LinearLayout
        a:id="@+id/pane_header_card"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:layout_marginBottom="8dp"
        a:clickable="true"
        a:focusable="true"
        a:gravity="center_vertical"
        a:orientation="horizontal"
        a:paddingStart="12dp"
        a:paddingTop="8dp"
        a:paddingEnd="12dp"
        a:paddingBottom="8dp">

        <!-- In fullscreen the exit button sits on the LEFT of the song title, leaving the
             right hand side free for the two upcoming tracks. -->
        <ImageButton
            a:id="@+id/pane_fullscreen_exit"
            a:layout_width="44dp"
            a:layout_height="44dp"
            a:layout_marginEnd="10dp"
            a:background="@drawable/car_control_bg"
            a:contentDescription="@string/player_fullscreen_exit"
            a:padding="9dp"
            a:scaleType="fitCenter"
            a:src="@drawable/ic_fullscreen_exit"
            a:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.card.MaterialCardView
            a:id="@+id/pane_cover_card"
            a:layout_width="50dp"
            a:layout_height="50dp"
            app:cardBackgroundColor="#18000000"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#24FFFFFF"
            app:strokeWidth="1dp">

            <ImageView
                a:id="@+id/pane_cover"
                a:layout_width="match_parent"
                a:layout_height="match_parent"
                a:contentDescription="@null"
                a:scaleType="centerCrop"
                a:src="@drawable/unknown_album" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            a:layout_width="0dp"
            a:layout_height="wrap_content"
            a:layout_marginStart="12dp"
            a:layout_marginEnd="8dp"
            a:layout_weight="1"
            a:orientation="vertical">

            <TextView
                a:id="@+id/pane_title"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:ellipsize="end"
                a:maxLines="1"
                a:text="@string/player_pane_idle"
                a:textColor="@color/pal_text_primary"
                a:textSize="17sp"
                a:textStyle="bold" />

            <TextView
                a:id="@+id/pane_artist"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:layout_marginTop="2dp"
                a:ellipsize="end"
                a:maxLines="1"
                a:text="@string/player_pane_idle_hint"
                a:textColor="@color/pal_text_secondary"
                a:textSize="13sp" />
        </LinearLayout>

        <TextView
            a:id="@+id/pane_status"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:ellipsize="end"
            a:maxLines="1"
            a:paddingStart="8dp"
            a:paddingTop="4dp"
            a:paddingEnd="8dp"
            a:paddingBottom="4dp"
            a:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            a:textColor="#FFC107"
            a:textSize="12sp"
            a:textStyle="bold"
            a:visibility="gone"
            tools:text="Buffering …"
            tools:visibility="visible" />

        <!-- Fullscreen only: the next two tracks stay visible to the RIGHT of the title.
             The clickable container keeps taps here from falling through to the header, which
             would otherwise leave fullscreen mode. -->
        <LinearLayout
            a:id="@+id/pane_up_next"
            a:layout_width="230dp"
            a:layout_height="wrap_content"
            a:layout_marginStart="12dp"
            a:layout_marginEnd="6dp"
            a:clickable="true"
            a:gravity="end"
            a:orientation="vertical"
            a:visibility="gone"
            tools:visibility="visible">

            <TextView
                a:id="@+id/pane_up_next_first"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:ellipsize="end"
                a:gravity="end"
                a:maxLines="1"
                a:textColor="@color/pal_text_primary"
                a:textSize="13sp"
                a:textStyle="bold"
                tools:text="Next  Bad Habits - Ed Sheeran" />

            <TextView
                a:id="@+id/pane_up_next_second"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:layout_marginTop="3dp"
                a:ellipsize="end"
                a:gravity="end"
                a:maxLines="1"
                a:textColor="@color/pal_text_secondary"
                a:textSize="12sp"
                tools:text="Then  Shape of You - Ed Sheeran" />
        </LinearLayout>

        <!-- One tap gives the lyrics the whole screen, a second one restores the library on
             the left. In fullscreen this button is hidden and the LEFT exit button takes over. -->
        <ImageButton
            a:id="@+id/pane_fullscreen"
            a:layout_width="44dp"
            a:layout_height="44dp"
            a:layout_marginStart="4dp"
            a:background="@drawable/car_control_bg"
            a:contentDescription="@string/player_fullscreen_enter"
            a:padding="9dp"
            a:scaleType="fitCenter"
            a:src="@drawable/ic_fullscreen_enter" />
    </LinearLayout>

    <!-- The lyrics and the queue share the same stage. Only one of them is shown, so
         the driver can switch between "what is playing" and "what comes next" without
         leaving the panel and without losing the player. -->
    <FrameLayout
        a:id="@+id/pane_stage_card"
        a:layout_width="match_parent"
        a:layout_height="0dp"
        a:layout_weight="1"
        a:paddingStart="10dp"
        a:paddingTop="6dp"
        a:paddingEnd="10dp"
        a:paddingBottom="6dp">

        <ScrollView
            a:id="@+id/pane_lyrics_scroll"
            a:layout_width="match_parent"
            a:layout_height="match_parent"
            a:fillViewport="true"
            a:scrollbars="none">

            <TextView
                a:id="@+id/pane_lyrics"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:alpha="1.0"
                a:gravity="start"
                a:lineSpacingExtra="12dp"
                a:paddingTop="12dp"
                a:paddingBottom="12dp"
                a:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                a:textColor="@color/pal_text_primary"
                a:textSize="20sp"
                tools:text="Lyrics" />

        </ScrollView>

        <androidx.recyclerview.widget.RecyclerView
            a:id="@+id/pane_queue"
            a:layout_width="match_parent"
            a:layout_height="match_parent"
            a:clipToPadding="false"
            a:scrollbars="vertical"
            a:visibility="gone"
            tools:visibility="visible" />

        <TextView
            a:id="@+id/pane_lyrics_source"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:layout_gravity="top|end"
            a:layout_marginTop="4dp"
            a:layout_marginEnd="6dp"
            a:background="@drawable/car_badge_bg"
            a:paddingStart="10dp"
            a:paddingTop="4dp"
            a:paddingEnd="10dp"
            a:paddingBottom="4dp"
            a:textColor="@color/pal_text_secondary"
            a:textSize="11sp"
            a:visibility="gone"
            tools:text="LRCLIB" />

    </FrameLayout>

    <LinearLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:layout_marginTop="4dp"
        a:gravity="center_vertical"
        a:orientation="horizontal">

        <TextView
            a:id="@+id/pane_elapsed"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:minWidth="46dp"
            a:textAppearance="@style/TextAppearance.Material3.BodySmall"
            a:textColor="@color/pal_text_secondary"
            a:textSize="13sp"
            tools:text="0:00" />

        <!-- Seeking by dragging a thumb is unreliable while driving, so the same distance is
             also available as a button on both sides of the bar. -->
        <TextView
            a:id="@+id/pane_seek_back"
            a:layout_width="56dp"
            a:layout_height="44dp"
            a:background="?attr/selectableItemBackgroundBorderless"
            a:contentDescription="@string/seek_backward_15"
            a:gravity="center"
            a:text="@string/seek_label_back_15"
            a:textColor="@color/pal_text_primary"
            a:textSize="14sp"
            a:textStyle="bold" />

        <SeekBar
            a:id="@+id/pane_seek"
            a:layout_width="0dp"
            a:layout_height="36dp"
            a:layout_weight="1"
            a:thumb="@drawable/car_seek_thumb" />

        <TextView
            a:id="@+id/pane_seek_forward"
            a:layout_width="56dp"
            a:layout_height="44dp"
            a:background="?attr/selectableItemBackgroundBorderless"
            a:contentDescription="@string/seek_forward_15"
            a:gravity="center"
            a:text="@string/seek_label_forward_15"
            a:textColor="@color/pal_text_primary"
            a:textSize="14sp"
            a:textStyle="bold" />

        <TextView
            a:id="@+id/pane_total"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:gravity="end"
            a:minWidth="46dp"
            a:textAppearance="@style/TextAppearance.Material3.BodySmall"
            a:textColor="@color/pal_text_secondary"
            a:textSize="13sp"
            tools:text="0:00" />

    </LinearLayout>

    <LinearLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:layout_marginTop="4dp"
        a:gravity="center"
        a:orientation="horizontal">

        <ImageButton
            a:id="@+id/pane_shuffle"
            a:layout_width="52dp"
            a:layout_height="52dp"
            a:background="@drawable/car_control_bg"
            a:contentDescription="@string/buttons.shuffle"
            a:padding="10dp"
            a:scaleType="fitCenter"
            a:src="@drawable/media_shuffle" />

        <ImageButton
            a:id="@+id/pane_previous"
            a:layout_width="60dp"
            a:layout_height="60dp"
            a:layout_marginStart="6dp"
            a:background="@drawable/car_control_bg"
            a:contentDescription="@string/buttons.previous"
            a:padding="12dp"
            a:scaleType="fitCenter"
            a:src="@drawable/media_backward" />

        <ImageButton
            a:id="@+id/pane_play"
            a:layout_width="68dp"
            a:layout_height="68dp"
            a:layout_marginStart="8dp"
            a:layout_marginEnd="8dp"
            a:background="@drawable/car_control_primary_bg"
            a:contentDescription="@string/buttons.play"
            a:padding="16dp"
            a:scaleType="fitCenter"
            a:src="@drawable/media_pause" />

        <ImageButton
            a:id="@+id/pane_next"
            a:layout_width="60dp"
            a:layout_height="60dp"
            a:layout_marginEnd="6dp"
            a:background="@drawable/car_control_bg"
            a:contentDescription="@string/buttons.next"
            a:padding="12dp"
            a:scaleType="fitCenter"
            a:src="@drawable/media_forward" />

        <ImageButton
            a:id="@+id/pane_repeat"
            a:layout_width="52dp"
            a:layout_height="52dp"
            a:background="@drawable/car_control_bg"
            a:contentDescription="@string/buttons.repeat"
            a:padding="10dp"
            a:scaleType="fitCenter"
            a:src="@drawable/media_repeat_off" />

        <!-- The queue shows what comes next. Without it the driver cannot tell whether
             the queue still holds a song worth hearing. -->
        <ImageButton
            a:id="@+id/pane_queue_button"
            a:layout_width="52dp"
            a:layout_height="52dp"
            a:layout_marginStart="6dp"
            a:background="@drawable/car_control_bg"
            a:contentDescription="@string/queue_title"
            a:padding="10dp"
            a:scaleType="fitCenter"
            a:src="@drawable/ic_queue" />

        <!-- One tap stops the music after a while, so the driver does not leave the car
             playing all night. -->
        <ImageButton
            a:id="@+id/pane_sleep"
            a:layout_width="52dp"
            a:layout_height="52dp"
            a:layout_marginStart="6dp"
            a:background="@drawable/car_control_bg"
            a:contentDescription="@string/sleep_timer"
            a:padding="10dp"
            a:scaleType="fitCenter"
            a:src="@drawable/ic_sleep" />


    <!-- Fullscreen-only quick tools. In fullscreen the pane has the full head-unit width,
         so the five shortcuts share ONE row with the transport buttons. The whole block
         stays GONE in the narrow two-pane layout, leaving the seven buttons untouched. -->
    <LinearLayout
        a:id="@+id/pane_quick_tools"
        a:layout_width="0dp"
        a:layout_height="wrap_content"
        a:layout_weight="1"
        a:gravity="center"
        a:orientation="horizontal"
        a:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            a:id="@+id/quick_theme"
            a:layout_width="0dp"
            a:layout_height="54dp"
            a:layout_weight="1"
            a:layout_marginStart="3dp"
            a:layout_marginEnd="3dp"
            a:background="@drawable/car_quick_tool_bg"
            a:clickable="true"
            a:focusable="true"
            a:gravity="center"
            a:orientation="vertical">

            <ImageView
                a:layout_width="22dp"
                a:layout_height="22dp"
                a:contentDescription="@null"
                a:scaleType="fitCenter"
                a:src="@drawable/ic_quick_theme" />

            <TextView
                a:layout_width="wrap_content"
                a:layout_height="wrap_content"
                a:layout_marginTop="2dp"
                a:maxLines="1"
                a:text="@string/quick_tools_theme"
                a:textColor="@color/pal_text_secondary"
                a:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            a:id="@+id/quick_playlist"
            a:layout_width="0dp"
            a:layout_height="54dp"
            a:layout_weight="1"
            a:layout_marginStart="3dp"
            a:layout_marginEnd="3dp"
            a:background="@drawable/car_quick_tool_bg"
            a:clickable="true"
            a:focusable="true"
            a:gravity="center"
            a:orientation="vertical">

            <ImageView
                a:layout_width="22dp"
                a:layout_height="22dp"
                a:contentDescription="@null"
                a:scaleType="fitCenter"
                a:src="@drawable/ic_quick_playlist" />

            <TextView
                a:layout_width="wrap_content"
                a:layout_height="wrap_content"
                a:layout_marginTop="2dp"
                a:maxLines="1"
                a:text="@string/quick_tools_playlist"
                a:textColor="@color/pal_text_secondary"
                a:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            a:id="@+id/quick_queue"
            a:layout_width="0dp"
            a:layout_height="54dp"
            a:layout_weight="1"
            a:layout_marginStart="3dp"
            a:layout_marginEnd="3dp"
            a:background="@drawable/car_quick_tool_bg"
            a:clickable="true"
            a:focusable="true"
            a:gravity="center"
            a:orientation="vertical">

            <ImageView
                a:layout_width="22dp"
                a:layout_height="22dp"
                a:contentDescription="@null"
                a:scaleType="fitCenter"
                a:src="@drawable/ic_quick_queue" />

            <TextView
                a:layout_width="wrap_content"
                a:layout_height="wrap_content"
                a:layout_marginTop="2dp"
                a:maxLines="1"
                a:text="@string/quick_tools_queue"
                a:textColor="@color/pal_text_secondary"
                a:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            a:id="@+id/quick_font"
            a:layout_width="0dp"
            a:layout_height="54dp"
            a:layout_weight="1"
            a:layout_marginStart="3dp"
            a:layout_marginEnd="3dp"
            a:background="@drawable/car_quick_tool_bg"
            a:clickable="true"
            a:focusable="true"
            a:gravity="center"
            a:orientation="vertical">

            <ImageView
                a:layout_width="22dp"
                a:layout_height="22dp"
                a:contentDescription="@null"
                a:scaleType="fitCenter"
                a:src="@drawable/ic_quick_font" />

            <TextView
                a:layout_width="wrap_content"
                a:layout_height="wrap_content"
                a:layout_marginTop="2dp"
                a:maxLines="1"
                a:text="@string/quick_tools_font"
                a:textColor="@color/pal_text_secondary"
                a:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            a:id="@+id/quick_settings"
            a:layout_width="0dp"
            a:layout_height="54dp"
            a:layout_weight="1"
            a:layout_marginStart="3dp"
            a:layout_marginEnd="3dp"
            a:background="@drawable/car_quick_tool_bg"
            a:clickable="true"
            a:focusable="true"
            a:gravity="center"
            a:orientation="vertical">

            <ImageView
                a:layout_width="22dp"
                a:layout_height="22dp"
                a:contentDescription="@null"
                a:scaleType="fitCenter"
                a:src="@drawable/ic_quick_settings" />

            <TextView
                a:layout_width="wrap_content"
                a:layout_height="wrap_content"
                a:layout_marginTop="2dp"
                a:maxLines="1"
                a:text="@string/quick_tools_settings"
                a:textColor="@color/pal_text_secondary"
                a:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

    </LinearLayout>

</LinearLayout>
</FrameLayout>
