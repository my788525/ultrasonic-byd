<?xml version="1.0" encoding="utf-8"?>
<!-- One tile of the home screen grid. The gradient background and the accent are applied in
     code, because they depend on the selected palette. -->
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    a:layout_width="0dp"
    a:layout_height="match_parent"
    a:clickable="true"
    a:focusable="true"
    a:gravity="center"
    a:orientation="vertical"
    a:paddingStart="12dp"
    a:paddingTop="16dp"
    a:paddingEnd="12dp"
    a:paddingBottom="16dp">

    <ImageView
        a:id="@+id/home_tile_icon"
        a:layout_width="22dp"
        a:layout_height="22dp"
        a:contentDescription="@null"
        a:scaleType="fitCenter" />

    <TextView
        a:id="@+id/home_tile_label"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:layout_marginTop="12dp"
        a:ellipsize="end"
        a:gravity="center"
        a:maxLines="1"
        a:textColor="@color/pal_text_primary"
        a:textSize="19sp" />
</LinearLayout>
