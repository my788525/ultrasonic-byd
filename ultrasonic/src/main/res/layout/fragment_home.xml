<?xml version="1.0" encoding="utf-8"?>
<!--
  Home screen of the head unit.

  Sized for a 1920x1080 (15.6") panel, which is about 1280x720 dp, but every dimension is
  relative: the two rows of tiles share the remaining height, so the screen also works in the
  BYD split screen and on narrower panels without scrolling.
-->
<ScrollView xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:id="@+id/home_scroll"
    a:layout_width="match_parent"
    a:layout_height="match_parent"
    a:background="@android:color/transparent"
    a:clipToPadding="false"
    a:fillViewport="true"
    a:scrollbars="none">

    <!-- A scroll view can only hold one child, and this one carries the padding of the screen
         and the vertical stack of the card and the tile grid. -->
    <LinearLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:orientation="vertical"
        a:paddingStart="24dp"
        a:paddingTop="8dp"
        a:paddingEnd="24dp"
        a:paddingBottom="16dp"
        tools:ignore="UselessParent">

        <!-- Continue playing: the single biggest touch target of the screen -->
        <FrameLayout
            a:id="@+id/home_continue_card"
            a:layout_width="match_parent"
            a:layout_height="104dp"
            a:clickable="true"
            a:focusable="true"
            a:paddingStart="6dp"
            a:paddingEnd="6dp">

            <LinearLayout
                a:layout_width="match_parent"
                a:layout_height="match_parent"
                a:gravity="center_vertical"
                a:orientation="horizontal"
                a:paddingStart="14dp"
                a:paddingEnd="14dp"
                a:paddingBottom="4dp">

                <com.google.android.material.card.MaterialCardView
                    a:id="@+id/home_cover_card"
                    a:layout_width="68dp"
                    a:layout_height="68dp"
                    app:cardBackgroundColor="#18000000"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#26FFFFFF"
                    app:strokeWidth="1dp">

                    <ImageView
                        a:id="@+id/home_cover"
                        a:layout_width="match_parent"
                        a:layout_height="match_parent"
                        a:contentDescription="@null"
                        a:scaleType="centerCrop" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    a:layout_width="0dp"
                    a:layout_height="wrap_content"
                    a:layout_marginStart="16dp"
                    a:layout_marginEnd="8dp"
                    a:layout_weight="1"
                    a:orientation="vertical">

                    <TextView
                        a:id="@+id/home_continue_label"
                        a:layout_width="wrap_content"
                        a:layout_height="wrap_content"
                        a:ellipsize="end"
                        a:letterSpacing="0.08"
                        a:maxLines="1"
                        a:text="@string/home_continue_playing"
                        a:textColor="@color/pal_text_secondary"
                        a:textSize="12sp"
                        a:textStyle="bold" />

                    <TextView
                        a:id="@+id/home_title"
                        a:layout_width="match_parent"
                        a:layout_height="wrap_content"
                        a:layout_marginTop="2dp"
                        a:ellipsize="end"
                        a:maxLines="1"
                        a:text="@string/home_idle"
                        a:textColor="@color/pal_text_primary"
                        a:textSize="20sp"
                        a:textStyle="bold" />

                    <TextView
                        a:id="@+id/home_artist"
                        a:layout_width="match_parent"
                        a:layout_height="wrap_content"
                        a:layout_marginTop="2dp"
                        a:ellipsize="end"
                        a:maxLines="1"
                        a:text="@string/home_idle_hint"
                        a:textColor="@color/pal_text_secondary"
                        a:textSize="14sp" />
                </LinearLayout>

                <ImageButton
                    a:id="@+id/home_nav_mode"
                    a:layout_width="44dp"
                    a:layout_height="44dp"
                    a:layout_marginEnd="4dp"
                    a:background="?attr/selectableItemBackgroundBorderless"
                    a:contentDescription="@string/settings_nav_floating_title"
                    a:padding="10dp"
                    a:scaleType="fitCenter"
                    a:src="@drawable/ic_nav_mode" />

                <ImageButton
                    a:id="@+id/home_shuffle"
                    a:layout_width="44dp"
                    a:layout_height="44dp"
                    a:layout_marginEnd="4dp"
                    a:background="?attr/selectableItemBackgroundBorderless"
                    a:contentDescription="@string/home_play_all_shuffled"
                    a:padding="10dp"
                    a:scaleType="fitCenter"
                    a:src="@drawable/media_shuffle" />

                <ImageButton
                    a:id="@+id/home_prev"
                    a:layout_width="46dp"
                    a:layout_height="46dp"
                    a:layout_marginEnd="4dp"
                    a:background="?attr/selectableItemBackgroundBorderless"
                    a:contentDescription="@string/buttons.previous"
                    a:padding="10dp"
                    a:scaleType="fitCenter"
                    a:src="@drawable/media_backward" />

                <ImageButton
                    a:id="@+id/home_play"
                    a:layout_width="56dp"
                    a:layout_height="56dp"
                    a:layout_marginEnd="4dp"
                    a:contentDescription="@string/home_play_pause"
                    a:padding="15dp"
                    a:scaleType="fitCenter"
                    a:src="@drawable/media_start" />

                <ImageButton
                    a:id="@+id/home_next"
                    a:layout_width="46dp"
                    a:layout_height="46dp"
                    a:background="?attr/selectableItemBackgroundBorderless"
                    a:contentDescription="@string/buttons.next"
                    a:padding="10dp"
                    a:scaleType="fitCenter"
                    a:src="@drawable/media_forward" />

            </LinearLayout>

            <!-- 进度条必须是 FrameLayout 的覆盖层。之前放在水平 LinearLayout 里，
                 match_parent 宽度会把 weight=1 的歌名/歌手区域挤成 0，并造成二次测量。 -->
            <ProgressBar
                a:id="@+id/home_progress"
                style="?android:attr/progressBarStyleHorizontal"
                a:layout_width="match_parent"
                a:layout_height="4dp"
                a:layout_gravity="bottom"
                a:layout_marginStart="16dp"
                a:layout_marginEnd="16dp"
                a:layout_marginBottom="7dp"
                a:max="1000"
                a:progress="0" />
        </FrameLayout>

        <!-- My playlists: the driver's playlists from the server, shown straight on the home
             screen so a playlist is only ever one tap away. Tapping one starts it immediately
             and continues where it was left off when a position is saved. Pinned playlists are
             sorted to the front. Hidden until at least one playlist is known. -->
        <LinearLayout
            a:id="@+id/home_playlists_container"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:orientation="vertical"
            a:visibility="gone">

            <LinearLayout
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:layout_marginTop="16dp"
                a:layout_marginBottom="2dp"
                a:gravity="center_vertical"
                a:orientation="horizontal">

                <TextView
                    a:layout_width="wrap_content"
                    a:layout_height="wrap_content"
                    a:letterSpacing="0.10"
                    a:text="@string/home_playlists_title"
                    a:textColor="@color/pal_text_primary"
                    a:textSize="15sp"
                    a:textStyle="bold" />

                <TextView
                    a:id="@+id/home_playlists_more"
                    a:layout_width="0dp"
                    a:layout_height="wrap_content"
                    a:layout_weight="1"
                    a:background="?attr/selectableItemBackgroundBorderless"
                    a:clickable="true"
                    a:focusable="true"
                    a:gravity="end|center_vertical"
                    a:letterSpacing="0.04"
                    a:paddingTop="4dp"
                    a:paddingBottom="4dp"
                    a:text="@string/home_playlists_hint"
                    a:textColor="@color/pal_text_secondary"
                    a:textSize="13sp" />
            </LinearLayout>

            <!-- 横向滚动：所有歌单都能左右滑到；高度在代码里按设置的行数精确指定，
                 否则嵌套在 ScrollView 中的 wrap_content 只会测量第一屏。
                 卡片宽度在代码里按可用宽度 / 列数动态计算，保证设置的数量就是首屏数量。 -->
            <androidx.recyclerview.widget.RecyclerView
                a:id="@+id/home_playlists_grid"
                a:layout_width="match_parent"
                a:layout_height="@dimen/home_playlist_tile_height"
                a:layout_marginTop="8dp"
                a:clipToPadding="false"
                a:nestedScrollingEnabled="false"
                a:overScrollMode="ifContentScrolls"
                a:scrollbars="none" />
        </LinearLayout>

        <TextView
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:layout_marginTop="16dp"
            a:layout_marginBottom="2dp"
            a:letterSpacing="0.10"
            a:text="@string/home_library"
            a:textColor="@color/pal_text_primary"
            a:textSize="15sp"
            a:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            a:id="@+id/home_grid"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:layout_marginTop="8dp"
            a:nestedScrollingEnabled="false" />
    </LinearLayout>
</ScrollView>
