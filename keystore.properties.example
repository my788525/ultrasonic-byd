# 复制为 keystore.properties 并填入你自己的密钥；或用环境变量（CI 走这条路）。
#
#   BYD_KEYSTORE_FILE      密钥库文件路径
#   BYD_KEYSTORE_PASSWORD  密钥库口令
#   BYD_KEY_ALIAS          别名
#   BYD_KEY_PASSWORD       别名口令
#
# 两个都没配时，Release 会退回到 debug 签名并在构建日志里警告 —— fork 之后照样能编译。
storeFile=/absolute/path/to/your.jks
storePassword=change-me
keyAlias=your-alias
keyPassword=change-me
